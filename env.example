# Copy to .env and adjust before running docker compose.

# --- Flask ---
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
PREFERRED_URL_SCHEME=https
SESSION_COOKIE_SECURE=true

# --- Database (Postgres, used by docker-compose.yml) ---
POSTGRES_DB=seamdestress
POSTGRES_USER=seamdestress
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alternatively, set DATABASE_URL directly and it takes precedence:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# --- Uploads ---
UPLOAD_FOLDER=/data/uploads
MAX_CONTENT_LENGTH_MB=15

# --- Locale ---
DEFAULT_LOCALE=nl
DEFAULT_TIMEZONE=Europe/Brussels
DEFAULT_VAT_RATE=21

# --- Rate limiting ---
# Use redis://redis:6379/0 in multi-worker/production deployments.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10 per minute

# --- Initial admin user (created by `flask seed`) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Shop Owner

# --- Notifications (SMTP) ---
# Leave SMTP_HOST empty to disable sending — "Notify client" will log a
# failed attempt instead of erroring, so the app still works without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@example.com
